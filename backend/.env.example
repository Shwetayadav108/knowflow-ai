# ==============================================================================
# KnowFlow AI - Backend Environment Configuration Example
# ==============================================================================
# IMPORTANT NOTICE:
# Spring Boot does NOT automatically load .env files at startup without a custom
# loader or library. You must export these environment variables into your system,
# your shell environment (PowerShell, Bash), or via container orchestrators
# (Docker Compose, Kubernetes, Helm) before launching the application.
#
# DO NOT COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECURITY & JWT CONFIGURATION (MANDATORY)
# ------------------------------------------------------------------------------
# JWT_SECRET: Cryptographic signing secret for HMAC-SHA256 JWT tokens.
# Minimum security requirement: At least 256 bits (32 bytes / 32 characters minimum).
# Example generator: openssl rand -base64 48
JWT_SECRET=your-secure-high-entropy-jwt-signing-secret-at-least-32-chars-long

# CORS_ALLOWED_ORIGINS: Comma-separated list of permitted web frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL / PRODUCTION PROFILE)
# ------------------------------------------------------------------------------
# In the default "local" profile, an in-memory H2 database is used with zero external
# dependencies. In the "prod" profile, PostgreSQL with pgvector is required.
# DB_USER and DB_PASSWORD have NO default fallback in production and MUST be set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=knowflow_ai
DB_USER=your_postgres_username
DB_PASSWORD=your_postgres_password

# ------------------------------------------------------------------------------
# 3. ARTIFICIAL INTELLIGENCE & LLM ENGINE (GEMINI)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API Key for production RAG and embeddings.
# In the "local" profile, an offline grounded fallback engine is available if no key is set.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------------------
# 4. STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# STORAGE_TYPE: local or s3
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./storage/documents

# ------------------------------------------------------------------------------
# 5. SMTP EMAIL CONFIGURATION (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
# SMTP configuration for production email dispatch (password reset codes, etc.)
# If unconfigured, the application starts safely and reports delivery unavailable.
KNOWFLOW_MAIL_SMTP_HOST=
KNOWFLOW_MAIL_SMTP_PORT=587
KNOWFLOW_MAIL_SMTP_USERNAME=
KNOWFLOW_MAIL_SMTP_PASSWORD=
KNOWFLOW_MAIL_FROM=no-reply@knowflow.ai
KNOWFLOW_MAIL_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# HOW TO RUN IN WINDOWS POWERSHELL:
# ------------------------------------------------------------------------------
# $env:JWT_SECRET = "your-secure-high-entropy-jwt-signing-secret-at-least-32-chars-long"
# $env:SPRING_PROFILES_ACTIVE = "local"
# mvn spring-boot:run
#
# FOR PRODUCTION (PostgreSQL):
# $env:JWT_SECRET = "your-secure-high-entropy-jwt-signing-secret-at-least-32-chars-long"
# $env:DB_USER = "knowflow_user"
# $env:DB_PASSWORD = "your_secure_db_password"
# $env:SPRING_PROFILES_ACTIVE = "prod"
# mvn spring-boot:run
# ==============================================================================
